{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pnpm: compile",
      "type": "shell",
      "command": "pnpm run compile",
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true,
        "close": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "pnpm: watch",
      "type": "shell",
      "command": "pnpm run watch",
      "problemMatcher": "$tsc-watch",
      "isBackground": true
    }
  ]
}
